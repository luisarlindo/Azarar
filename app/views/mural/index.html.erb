<div class="tab-page tab-radar active" style="display: flex;">
  <div class="radar-control-card">
    <div class="control-header">
      <div class="control-title-wrap">
        <span class="radar-icon-pulse">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
        </span>
        <div>
          <h3 class="control-title">Estou Online Agora</h3>
          <p class="control-desc">VisÃ­vel no radar e no mural de proximidade</p>
        </div>
      </div>
      
      <label class="toggle-switch">
        <input type="checkbox" id="chkOnlineNow" <%= current_user.online_now? ? 'checked' : '' %> onchange="toggleOnlineStatus(this.checked)" />
        <span class="toggle-slider"></span>
      </label>
    </div>

    <div class="radius-selector-wrap">
      <div class="radius-label-row">
        <span class="radius-title">Raio de Proximidade:</span>
        <strong class="radius-val-highlight" id="lblCurrentRadius"><%= current_user.radius_meters %> metros</strong>
      </div>
      <div class="radius-chips-list" id="radiusChipsList">
        <% [200, 400, 500, 1000, 2000, 5000].each do |r| %>
          <button class="radius-chip <%= current_user.radius_meters == r ? 'active' : '' %>" onclick="setRadius(<%= r %>)"><%= r >= 1000 ? "#{r/1000} km" : "#{r}m" %></button>
        <% end %>
      </div>
    </div>
  </div>

  <div class="subnav-radar">
    <button class="subnav-btn active" id="btnSubnavUsers" onclick="switchRadarSubTab('users')">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
      Pessoas no Raio (<%= @online_users.count %>)
    </button>
    <button class="subnav-btn" id="btnSubnavMural" onclick="switchRadarSubTab('mural')">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z"/></svg>
      Mural Aberto do Raio
    </button>
  </div>

  <div class="radar-subcontent" id="subtabUsers">
    <div class="nearby-users-grid">
      <% @online_users.each do |user| %>
        <div class="nearby-user-card" onclick="window.location='<%= user_path(user) %>'">
          <div class="user-card-image-wrap">
            <img src="<%= user.display_avatar %>" alt="<%= user.name %>" class="user-card-avatar" />
            <span class="user-live-indicator"><span class="live-dot"></span> No Raio</span>
            <div class="user-card-overlay">
              <h4 class="user-name-age"><%= user.name %>, <%= user.age || 24 %></h4>
              <span class="user-handle"><%= user.formatted_username %></span>
            </div>
          </div>
          <div class="user-card-footer">
            <span class="dist-badge">ðŸ“ <%= user.radius_meters %>m</span>
            <a href="<%= direct_message_path(user) %>" class="btn-card-chat" onclick="event.stopPropagation()">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>
              Conversar
            </a>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="radar-subcontent" id="subtabMural" style="display: none;">
    <div class="mural-chat-box">
      <div class="mural-banner">
        <span class="mural-badge">ðŸ”¥ Chat Aberto</span>
        <p class="mural-info">Todos que estÃ£o dentro de <strong id="muralRadiusText"><%= current_user.radius_meters %>m</strong> podem ler e responder livremente aqui!</p>
      </div>
      
      <div class="mural-messages-scroll" id="muralMessagesList">
        <% @mural_messages.each do |msg| %>
          <div class="mural-message-item <%= msg.user == current_user ? 'my-message' : '' %>">
            <img src="<%= msg.user.display_avatar %>" alt="<%= msg.user.name %>" class="mural-msg-avatar" />
            <div class="mural-msg-bubble">
              <div class="mural-msg-author">
                <strong><%= msg.user.name %></strong>
                <span class="mural-msg-handle"><%= msg.user.formatted_username %></span>
                <span class="mural-msg-time"><%= msg.created_at.strftime("%H:%M") %></span>
              </div>
              <p class="mural-msg-text"><%= msg.content %></p>
            </div>
          </div>
        <% end %>
      </div>

      <%= form_with model: @mural_message, url: mural_messages_path, class: "mural-input-bar", data: { turbo: false } do |f| %>
        <%= f.text_field :content, placeholder: "Envie uma mensagem no mural local...", required: true %>
        <button type="submit" class="btn-send-mural" aria-label="Enviar mensagem">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
        </button>
      <% end %>
    </div>
  </div>
</div>

<script>
  function switchRadarSubTab(tab) {
    const btnUsers = document.getElementById('btnSubnavUsers');
    const btnMural = document.getElementById('btnSubnavMural');
    const subUsers = document.getElementById('subtabUsers');
    const subMural = document.getElementById('subtabMural');

    if (tab === 'users') {
      btnUsers.classList.add('active');
      btnMural.classList.remove('active');
      subUsers.style.display = 'block';
      subMural.style.display = 'none';
    } else {
      btnMural.classList.add('active');
      btnUsers.classList.remove('active');
      subMural.style.display = 'block';
      subUsers.style.display = 'none';
      const list = document.getElementById('muralMessagesList');
      if (list) list.scrollTop = list.scrollHeight;
    }
  }

  function setRadius(meters) {
    fetch('<%= toggle_online_profile_path %>', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
      },
      body: JSON.stringify({ radius_meters: meters })
    }).then(res => res.json()).then(data => {
      document.getElementById('lblCurrentRadius').innerText = meters >= 1000 ? (meters/1000) + ' km' : meters + ' metros';
      document.getElementById('muralRadiusText').innerText = meters >= 1000 ? (meters/1000) + ' km' : meters + 'm';
      document.querySelectorAll('#radiusChipsList .radius-chip').forEach(btn => {
        btn.classList.toggle('active', btn.innerText.includes(meters >= 1000 ? (meters/1000)+' ' : meters+'m'));
      });
    });
  }

  function toggleOnlineStatus(checked) {
    fetch('<%= toggle_online_profile_path %>', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
      },
      body: JSON.stringify({ online_now: checked })
    }).then(res => res.json()).then(data => {
      const badge = document.getElementById('topbarOnlineBadge');
      const text = document.getElementById('topbarOnlineText');
      if (badge && text) {
        if (data.online_now) {
          badge.classList.remove('offline');
          text.innerText = 'Online';
        } else {
          badge.classList.add('offline');
          text.innerText = 'Invisível';
        }
      }
    });
  }
</script>