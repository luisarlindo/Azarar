            </ul>
            <button type="button" class="btn-upgrade-tier btn-tier-bronze" onclick="event.stopPropagation(); window.azararApp.subscribeToPlan('bronze', 'Plano Bronze', 9.90)">
              Assinar Bronze (R$ 9,90)
            </button>
          </div>

          <!-- PLANO 3: PRATA -->
          <div class="vip-plan-card" id="planCardPrata" onclick="window.azararApp.selectVipPlan('prata')">
            <div class="plan-card-header">
              <div>
                <h4 class="plan-name silver-glow">🥈 Prata</h4>
                <span class="plan-price">R$ 19,90 <small>/mês</small></span>
              </div>
              <span class="plan-badge-tier">Plus</span>
            </div>
            <ul class="plan-features">
              <li>🚀 Radar metropolitano até <strong>30 km</strong></li>
              <li>🥂 30 Brindes diários</li>
              <li>👻 <strong>Modo Fantasma</strong> (Navegação Invisível)</li>
              <li>🛡️ Selo Prata no Perfil</li>
              <li>💬 Chat estendido de 12 horas</li>
            </ul>
            <button type="button" class="btn-upgrade-tier btn-tier-prata" onclick="event.stopPropagation(); window.azararApp.subscribeToPlan('prata', 'Plano Prata', 19.90)">
              Assinar Prata (R$ 19,90)
            </button>
          </div>

          <!-- PLANO 4: OURO (DESTAQUE) -->
          <div class="vip-plan-card featured-gold-card" id="planCardOuro" onclick="window.azararApp.selectVipPlan('ouro')">
            <div class="popular-ribbon">⭐ MAIS ESCOLHIDO</div>
            <div class="plan-card-header">
              <div>
                <h4 class="plan-name gold-glow">🥇 Ouro VIP</h4>
                <span class="plan-price">R$ 39,90 <small>/mês</small></span>
              </div>
              <span class="plan-badge-gold">Recomendado</span>
            </div>
            <ul class="plan-features">
              <li>🎯 Radar amplo até <strong>50 km</strong></li>
              <li>🥂 <strong>Brindes Ilimitados</strong></li>
              <li>👀 <strong>Ver quem te curtiu</strong> antes do match</li>
              <li>🔓 Acesso livre ao <strong>Lounge VIP</strong></li>
              <li>⭐ Selo Ouro VIP no Perfil</li>
              <li>💬 Chat de 24 horas</li>
            </ul>
            <button type="button" class="btn-upgrade-tier btn-tier-ouro" onclick="event.stopPropagation(); window.azararApp.subscribeToPlan('ouro', 'Plano Ouro VIP', 39.90)">
              Assinar Ouro VIP (R$ 39,90)
            </button>
          </div>

          <!-- PLANO 5: PLATINA BLACK -->
          <div class="vip-plan-card platinum-glow-card" id="planCardPlatina" onclick="window.azararApp.selectVipPlan('platina')">
            <div class="plan-card-header">
              <div>
                <h4 class="plan-name plat-glow">👑 Platina Black</h4>
                <span class="plan-price">R$ 69,90 <small>/mês</small></span>
              </div>
              <span class="plan-badge-plat">VIP Máximo</span>
            </div>
            <ul class="plan-features">
              <li>🌍 Radar de alcance máximo até <strong>100 km</strong></li>
              <li>⚡ <strong>1 Flash Boost semanal grátis</strong> (topo da noite por 1h)</li>
              <li>⏳ <strong>Conversas Permanentes</strong> (Chat sem expiração)</li>
              <li>💎 Selo Platina Diamante & Verificação Prioritária</li>
              <li>↩️ Desfazer brindes enviados por engano</li>
            </ul>
            <button type="button" class="btn-upgrade-tier btn-tier-platina" onclick="event.stopPropagation(); window.azararApp.subscribeToPlan('platina', 'Plano Platina Black', 69.90)">
              Assinar Platina (R$ 69,90)
            </button>
          </div>

        </div>

        <div class="vip-guarantee-note">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="#22c55e"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
          <span>Cancele a qualquer momento. Pagamento seguro via Pix ou Cartão.</span>
        </div>
      </div>
    </div>

    <!-- ============================================ -->
    <!-- MODAL: FLASH BOOST (DESTAQUE NA NOITE)      -->
    <!-- ============================================ -->
    <div class="app-modal" id="modalFlashBoost" role="dialog" aria-modal="true">
      <div class="modal-backdrop" onclick="window.azararApp.closeFlashBoostModal()"></div>
      <div class="modal-card-sheet flash-boost-sheet">
        <div class="modal-header">
          <h3 class="modal-title">⚡ Flash Boost Camarote</h3>
          <button class="modal-close-btn" onclick="window.azararApp.closeFlashBoostModal()">✕</button>
        </div>

        <div class="boost-hero-graphic">
          <div class="boost-icon-pulse">⚡</div>
          <h4 class="boost-callout-title">Seja o Perfil nº 1 da Balada por 1 Hora!</h4>
          <p class="boost-callout-desc">Seu perfil e momentos serão exibidos no topo do Radar e do Lounge VIP para todos os usuários em um raio de até 10 km.</p>
        </div>

        <div class="boost-pricing-box">
          <div class="boost-price-tag">
            <span class="boost-val">R$ 9,90</span>
            <span class="boost-period">/ 1 hora de destaque</span>
          </div>
          <button type="button" class="btn-primary btn-activate-boost" onclick="window.azararApp.activateFlashBoost()">
            🚀 Ativar Flash Boost Agora
          </button>
        </div>
      </div>
    </div>

    <!-- ============================================ -->
    <!-- MODAL: FILTROS & CONFIGURAÇÕES DO RADAR     -->
    <!-- ============================================ -->
    <div class="app-modal" id="modalRadarFilters" role="dialog" aria-modal="true">
      <div class="modal-backdrop" onclick="window.azararApp.closeRadarFiltersModal()"></div>
      <div class="modal-card-sheet radar-filters-sheet">
        <div class="modal-header">
          <h3 class="modal-title">⚙️ Filtros do Radar</h3>
          <button class="modal-close-btn" onclick="window.azararApp.closeRadarFiltersModal()">✕</button>
        </div>

        <div class="radar-filters-body">
          <!-- 1. O que exibir no Radar -->
          <div class="filter-section-group">
            <label class="filter-group-label">Exibir no Radar</label>
            <div class="filter-options-grid three-cols">
              <button type="button" class="filter-select-btn active" id="fBtnAll" onclick="window.azararApp.selectRadarDisplayType('all')">
                <span class="f-icon">✨</span>
                <span>Tudo</span>
              </button>
              <button type="button" class="filter-select-btn" id="fBtnVenues" onclick="window.azararApp.selectRadarDisplayType('venues')">
                <span class="f-icon">📍</span>
                <span>Locais</span>
              </button>
              <button type="button" class="filter-select-btn" id="fBtnPeople" onclick="window.azararApp.selectRadarDisplayType('people')">
                <span class="f-icon">👥</span>
                <span>Pessoas</span>
              </button>
            </div>
          </div>

          <!-- 2. Sub-categorias de Locais & Points -->
          <div class="filter-section-group" id="groupVenueSubCategories">
            <label class="filter-group-label">Tipos de Estabelecimentos & Points</label>
            <div class="filter-subcategories-list">
              <label class="filter-checkbox-item">
                <input type="checkbox" class="venue-cat-chk" value="bar" checked onchange="window.azararApp.onVenueCategoryToggle()" />
                <span class="chk-box-custom"></span>
                <span class="chk-label">🍸 Bares & Petiscos</span>
              </label>
              <label class="filter-checkbox-item">
                <input type="checkbox" class="venue-cat-chk" value="beach" checked onchange="window.azararApp.onVenueCategoryToggle()" />
                <span class="chk-box-custom"></span>
                <span class="chk-label">🏖️ Praias, Orla & Quiosques</span>
              </label>
              <label class="filter-checkbox-item">
                <input type="checkbox" class="venue-cat-chk" value="convenience" checked onchange="window.azararApp.onVenueCategoryToggle()" />
                <span class="chk-box-custom"></span>
                <span class="chk-label">⛽ Postos & Esquenta de Balada</span>
              </label>
              <label class="filter-checkbox-item">
                <input type="checkbox" class="venue-cat-chk" value="nightclub" checked onchange="window.azararApp.onVenueCategoryToggle()" />
                <span class="chk-box-custom"></span>
                <span class="chk-label">🔥 Baladas, Lounges & Música ao Vivo</span>
              </label>
              <label class="filter-checkbox-item">
                <input type="checkbox" class="venue-cat-chk" value="restaurant" checked onchange="window.azararApp.onVenueCategoryToggle()" />
                <span class="chk-box-custom"></span>
                <span class="chk-label">🍽️ Restaurantes & Gastronomia</span>
              </label>
            </div>
          </div>

          <!-- 3. Filtro de Vibes das Pessoas -->
          <div class="filter-section-group" id="groupPeopleVibes">
            <label class="filter-group-label">Filtrar Pessoas por Vibe</label>
            <div class="filter-options-grid three-cols">
              <button type="button" class="filter-vibe-btn active" data-vibe="all" onclick="window.azararApp.selectVibeFilter('all')">Todas</button>
              <button type="button" class="filter-vibe-btn" data-vibe="romance" onclick="window.azararApp.selectVibeFilter('romance')">💖 Romance</button>
              <button type="button" class="filter-vibe-btn" data-vibe="festa" onclick="window.azararApp.selectVibeFilter('festa')">🔥 Balada</button>
            </div>
          </div>

          <!-- Botão Aplicar -->
          <button type="button" class="btn-primary btn-apply-filters" onclick="window.azararApp.applyRadarFilters()">
            Aplicar Filtros 🎯
          </button>
        </div>
      </div>
    </div>

    <!-- ============================================ -->
    <!-- MODAL: DETALHES DO LOCAL & POINT (B2B & ORGÂNICO) -->
    <!-- ============================================ -->
    <div class="app-modal" id="modalVenueDetails" role="dialog" aria-modal="true">
      <div class="modal-backdrop" onclick="window.azararApp.closeVenueDetailsModal()"></div>
      <div class="modal-card-sheet venue-details-sheet">
        <div class="modal-header venue-sheet-header">
          <div class="venue-header-badge-wrap" id="venueHeaderBadgeWrap">
            <!-- Dynamically populated (e.g. ⭐ PARCEIRO OFICIAL AZARAR) -->
          </div>
          <button class="modal-close-btn" onclick="window.azararApp.closeVenueDetailsModal()">✕</button>
        </div>

        <!-- Venue Modal Scroll Body -->
        <div class="venue-modal-scroll-body" id="venueModalScrollBody">
          <!-- Dynamically populated via renderVenueModalContent(venue) -->
        </div>
      </div>
    </div>

    <!-- Toast Notification -->
    <div class="toast-notification" id="toastNotification" aria-live="polite"></div>

  </main>

  <!-- JavaScript -->
  <script src="/js/app.js?v=<%= Time.current.to_i %>"></script>
</body>
</html>