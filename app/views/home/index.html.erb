    </div>

    <!-- ============================================ -->
    <!-- MODAL: NOVA PUBLICAÇÃO (POST NO FEED)        -->
    <!-- ============================================ -->
    <div class="app-modal" id="modalNewPost" role="dialog" aria-modal="true">
      <div class="modal-backdrop" onclick="window.azararApp.closeNewPostModal()"></div>
      <div class="modal-card-sheet">
        <div class="modal-header">
          <h3 class="modal-title">Nova Publicação</h3>
          <button class="modal-close-btn" onclick="window.azararApp.closeNewPostModal()">✕</button>
        </div>

        <form class="modal-form" onsubmit="event.preventDefault(); window.azararApp.handleCreatePostSubmit();">
          
          <label>Selecione ou Cole a URL de uma Foto:</label>
          <div class="preset-photos-row" id="presetPhotosRow">
            <!-- Preset sample photos clickable -->
          </div>

          <div class="form-group" style="margin-top: 10px;">
            <label for="txtPostImageUrl">Ou URL personalizada da imagem:</label>
            <div class="input-wrap">
              <input type="url" id="txtPostImageUrl" placeholder="https://exemplo.com/minha-foto.jpg" />
            </div>
          </div>

          <div class="form-group">
            <label for="txtPostCaption">Legenda da foto:</label>
            <div class="input-wrap">
              <textarea id="txtPostCaption" rows="3" placeholder="O que você está fazendo ou pensando agora?..." required></textarea>
            </div>
          </div>

          <div class="form-group">
            <label for="txtPostLocation">Localização:</label>
            <div class="input-wrap">
              <input type="text" id="txtPostLocation" placeholder="Ex: Rooftop Bar, Jardins" value="São Paulo, SP" />
            </div>
          </div>

          <button type="submit" class="btn-primary" style="margin-top: 12px; height: 50px;">
            <span>Publicar no Feed</span>
          </button>
        </form>
      </div>
    </div>

    <!-- ============================================ -->
    <!-- MODAL: EDITAR PERFIL                         -->
    <!-- ============================================ -->
    <div class="app-modal" id="modalEditProfile" role="dialog" aria-modal="true">
      <div class="modal-backdrop" onclick="window.azararApp.closeEditProfileModal()"></div>
      <div class="modal-card-sheet">
        <div class="modal-header">
          <h3 class="modal-title">Editar Meu Perfil</h3>
          <button class="modal-close-btn" onclick="window.azararApp.closeEditProfileModal()">✕</button>
        </div>

        <form class="modal-form" onsubmit="event.preventDefault(); window.azararApp.handleEditProfileSubmit();">
          
          <div class="form-group">
            <label for="editFullName">Nome completo</label>
            <div class="input-wrap">
              <input type="text" id="editFullName" required />
            </div>
          </div>

          <div class="form-group">
            <label for="editBio">Biografia</label>
            <div class="input-wrap">
              <textarea id="editBio" rows="3" placeholder="Conte um pouco sobre sua vibe e o que você curte..."></textarea>
            </div>
          </div>

          <div class="form-group">
            <label>Intenção Principal:</label>
            <div class="intent-chips-grid" id="editIntentChips">
              <button type="button" class="intent-chip" data-intent="Relacionamento Sério">💍 Relacionamento Sério</button>
              <button type="button" class="intent-chip" data-intent="Casual">🍹 Encontros Casuais</button>
              <button type="button" class="intent-chip" data-intent="Sexo">💋 Sexo sem tabus</button>
              <button type="button" class="intent-chip" data-intent="Companhia">✨ Companhia & Amizade</button>
            </div>
          </div>

          <div class="form-group">
            <label for="editAvatarUrl">URL da Foto de Perfil:</label>
            <div class="input-wrap">
              <input type="url" id="editAvatarUrl" placeholder="https://..." />
            </div>
          </div>

          <button type="submit" class="btn-primary" style="margin-top: 14px; height: 50px;">
            <span>Salvar Alterações</span>
          </button>
        </form>
      </div>
    </div>

    <!-- ============================================ -->
    <!-- MODAL: DIRECT CHAT (CONVERSA PRIVADA EFÊMERA) -->
    <!-- ============================================ -->
    <div class="app-modal modal-chat-fullscreen" id="modalDirectChat" role="dialog" aria-modal="true">
      <div class="chat-fullscreen-card">
        
        <div class="chat-header">
          <button class="nav-back-btn" type="button" onclick="window.azararApp.closeDirectChat()">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          
          <div class="chat-user-meta">
            <div class="chat-avatar-wrap">
              <img src="" id="chatActiveAvatar" alt="Avatar" class="chat-avatar" />
              <span class="chat-status-dot online"></span>
            </div>
            <div>
              <h4 class="chat-user-name" id="chatActiveName">Nome</h4>
              <span class="chat-user-sub" id="chatActiveSub">Online agora • No mesmo local</span>
            </div>
          </div>

          <button class="btn-chat-follow" id="btnChatFollow" onclick="window.azararApp.toggleFollowActiveChatUser()">
            Seguir
          </button>
        </div>

        <!-- Ephemeral Countdown Bar -->
        <div class="chat-countdown-bar" id="chatCountdownBar">
          <span class="pulse-dot"></span>
          <span>⏳ Chat Efêmero: Expira em <strong id="chatTimerCount">02h 59m 45s</strong></span>
        </div>

        <div class="chat-messages-container" id="directChatMessagesList">
          <!-- Messages dynamically populated -->
        </div>

        <!-- Quick Icebreaker Chips (1-Click Send) -->
        <div class="quick-icebreakers-row">
          <button type="button" class="icebreaker-chip" onclick="window.azararApp.sendQuickIcebreaker('🍹 Bora tomar um drink no bar?')">🍹 Bora tomar um drink?</button>
          <button type="button" class="icebreaker-chip" onclick="window.azararApp.sendQuickIcebreaker('👀 Tô de jaqueta preta perto do palco')">👀 Tô perto do palco</button>
          <button type="button" class="icebreaker-chip" onclick="window.azararApp.sendQuickIcebreaker('🥂 Qual mesa você tá?')">🥂 Qual mesa você tá?</button>
          <button type="button" class="icebreaker-chip" onclick="window.azararApp.sendQuickIcebreaker('💃 Bora pra pista de dança?')">💃 Bora pra pista?</button>
        </div>

        <form class="chat-input-bar" onsubmit="event.preventDefault(); window.azararApp.sendDirectChatMessage();">
          <input type="text" id="txtDirectChatInput" placeholder="Digite uma mensagem rápida..." required />
          <button type="submit" class="btn-send-mural" aria-label="Enviar">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
          </button>
        </form>

      </div>
    </div>

    <!-- ============================================ -->
    <!-- MODAL: BRINDE MÚTUO CELEBRATION (MATCH NO LOCAL) -->
    <!-- ============================================ -->
    <div class="app-modal" id="modalCheersCelebration" role="dialog" aria-modal="true">
      <div class="modal-backdrop" onclick="window.azararApp.closeCheersModal()"></div>
      <div class="modal-card-sheet cheers-celebration-card">
        <div class="cheers-avatars-row">
          <div class="cheers-avatar-circle">
            <img src="" id="cheersMyAvatar" alt="Você" />
          </div>
          <div class="cheers-icon-bounce">🥂</div>
          <div class="cheers-avatar-circle">
            <img src="" id="cheersTheirAvatar" alt="Parceiro(a)" />
          </div>
        </div>

        <h3 class="cheers-title">🎉 É UM BRINDE MÚTUO!</h3>
        <p class="cheers-subtitle" id="cheersSubtitle">Vocês dois brindaram e estão no mesmo local agora!</p>

        <div class="cheers-timer-warning">
          <span>⏳ Chat Efêmero desbloqueado: Expira em <strong>3 horas</strong> para combinarem de se falar no balcão.</span>
        </div>

        <button type="button" class="btn-primary btn-card-cheers" style="height: 48px; width: 100%;" onclick="window.azararApp.openDirectChatFromCheers()">
          <span>💬 Abrir Chat Efêmero</span>
        </button>

        <button type="button" class="btn-outline-login" style="margin-top: 10px; height: 42px; width: 100%; border: 1px solid rgba(255,255,255,0.2);" onclick="window.azararApp.closeCheersModal()">
          <span>Continuar no Radar</span>
        </button>
      </div>
    </div>

    <!-- ============================================ -->
    <!-- MODAL: RECONHECIMENTO FACIAL ANTI-FAKE       -->
    <!-- ============================================ -->
    <div class="app-modal" id="modalFaceVerification" role="dialog" aria-modal="true">
      <div class="modal-backdrop" onclick="window.azararApp.closeFaceVerificationModal()"></div>
      <div class="modal-card-sheet face-verif-modal-sheet">
        <div class="modal-header">
          <h3 class="modal-title">Reconhecimento Facial Anti-Fake</h3>
          <button class="modal-close-btn" onclick="window.azararApp.closeFaceVerificationModal()">✕</button>
        </div>

        <div class="face-scanner-container">
          <div class="camera-stream-wrap" id="cameraStreamWrap">
            <video id="faceCameraVideo" autoplay playsinline muted></video>
            <div class="face-target-oval">
              <div class="scan-laser-line"></div>
            </div>
          </div>

          <div class="face-scan-status-box">
            <div class="face-scan-status-badge" id="faceScanBadge">
              <span class="pulse-dot"></span>
              <span id="faceScanStatusText">Posicione seu rosto no centro</span>
            </div>
            <div class="face-progress-bar-wrap">
              <div class="face-progress-bar" id="faceProgressBar" style="width: 0%;"></div>
            </div>
          </div>
        </div>

        <div class="face-verif-actions" style="margin-top: 14px;">
          <button type="button" class="btn-primary" id="btnStartFaceScan" style="height: 48px; width: 100%;" onclick="window.azararApp.startFacialRecognitionScan()">
            <span>📸 Iniciar Reconhecimento Facial</span>
          </button>
          <button type="button" class="btn-outline-login" style="margin-top: 8px; height: 40px; width: 100%; border: 1px solid rgba(255,255,255,0.2);" onclick="window.azararApp.closeFaceVerificationModal()">
            Cancelar
          </button>
        </div>
      </div>
    </div>

    <!-- ============================================ -->
    <!-- MODAL: PLANOS VIP & UPGRADE                  -->
    <!-- ============================================ -->
    <div class="app-modal" id="modalVipPlans" role="dialog" aria-modal="true">
      <div class="modal-backdrop" onclick="window.azararApp.closeVipPlansModal()"></div>
      <div class="modal-card-sheet vip-plans-sheet">
        <div class="modal-header">
          <div>
            <span class="vip-sheet-tag">👑 EXPERIÊNCIA PREMIUM</span>
            <h3 class="modal-title">Escolha seu Plano VIP</h3>
          </div>
          <button class="modal-close-btn" onclick="window.azararApp.closeVipPlansModal()">✕</button>
        </div>

        <p class="vip-sheet-subtitle">Desbloqueie raios maiores no radar, brindes ilimitados e mídias exclusivas no Lounge.</p>

        <!-- PLANS CARDS LIST -->
        <div class="vip-tiers-list">
          
          <!-- PLANO 1: GRÁTIS -->
          <div class="vip-plan-card" id="planCardFree" onclick="window.azararApp.selectVipPlan('free')">
            <div class="plan-card-header">
              <div>
                <h4 class="plan-name">Grátis</h4>
                <span class="plan-price">R$ 0,00</span>
              </div>
              <span class="plan-badge-current" id="badgePlanFree">Plano Atual</span>
            </div>
            <ul class="plan-features">
              <li>✅ Radar regional até <strong>5 km</strong></li>
              <li>✅ 5 Brindes 🥂 diários</li>
              <li>✅ Chat efêmero de 3 horas</li>
            </ul>
          </div>

          <!-- PLANO 2: BRONZE -->
          <div class="vip-plan-card" id="planCardBronze" onclick="window.azararApp.selectVipPlan('bronze')">
            <div class="plan-card-header">
              <div>
                <h4 class="plan-name bronze-glow">🥉 Bronze</h4>
                <span class="plan-price">R$ 9,90 <small>/mês</small></span>
              </div>
              <span class="plan-badge-bronze">Básico</span>
            </div>
            <ul class="plan-features">
              <li>🚀 Radar estendido até <strong>15 km</strong></li>
              <li>🥂 15 Brindes diários</li>
              <li>🛡️ Selo Bronze no Perfil</li>
              <li>💬 Chat estendido de 6 horas</li>
            </ul>
            <button type="button" class="btn-upgrade-tier btn-tier-bronze" onclick="event.stopPropagation(); window.azararApp.subscribeToPlan('bronze', 'Plano Bronze', 9.90)">
              Assinar Bronze (R$ 9,90)
            </button>
          </div>

          <!-- PLANO 3: PRATA -->
          <div class="vip-plan-card" id="planCardPrata" onclick="window.azararApp.selectVipPlan('prata')">
            <div class="plan-card-header">
              <div>
                <h4 class="plan-name silver-glow">🥈 Prata</h4>
                <span class="plan-price">R$ 19,90 <small>/mês</small></span>
              </div>
              <span class="plan-badge-tier">Plus</span>
            </div>
            <ul class="plan-features">
              <li>🚀 Radar metropolitano até <strong>30 km</strong></li>
              <li>🥂 30 Brindes diários</li>
              <li>👻 <strong>Modo Fantasma</strong> (Navegação Invisível)</li>
              <li>🛡️ Selo Prata no Perfil</li>
              <li>💬 Chat estendido de 12 horas</li>
            </ul>
            <button type="button" class="btn-upgrade-tier btn-tier-prata" onclick="event.stopPropagation(); window.azararApp.subscribeToPlan('prata', 'Plano Prata', 19.90)">
              Assinar Prata (R$ 19,90)
            </button>
          </div>

          <!-- PLANO 4: OURO (DESTAQUE) -->
          <div class="vip-plan-card featured-gold-card" id="planCardOuro" onclick="window.azararApp.selectVipPlan('ouro')">
            <div class="popular-ribbon">⭐ MAIS ESCOLHIDO</div>
            <div class="plan-card-header">
              <div>
                <h4 class="plan-name gold-glow">🥇 Ouro VIP</h4>
                <span class="plan-price">R$ 39,90 <small>/mês</small></span>
              </div>
              <span class="plan-badge-gold">Recomendado</span>
            </div>
            <ul class="plan-features">
              <li>🎯 Radar amplo até <strong>50 km</strong></li>
              <li>🥂 <strong>Brindes Ilimitados</strong></li>
              <li>👀 <strong>Ver quem te curtiu</strong> antes do match</li>
              <li>🔓 Acesso livre ao <strong>Lounge VIP</strong></li>
              <li>⭐ Selo Ouro VIP no Perfil</li>
              <li>💬 Chat de 24 horas</li>
            </ul>
            <button type="button" class="btn-upgrade-tier btn-tier-ouro" onclick="event.stopPropagation(); window.azararApp.subscribeToPlan('ouro', 'Plano Ouro VIP', 39.90)">
              Assinar Ouro VIP (R$ 39,90)
            </button>
          </div>

          <!-- PLANO 5: PLATINA BLACK -->
          <div class="vip-plan-card platinum-glow-card" id="planCardPlatina" onclick="window.azararApp.selectVipPlan('platina')">
            <div class="plan-card-header">
              <div>
                <h4 class="plan-name plat-glow">👑 Platina Black</h4>
                <span class="plan-price">R$ 69,90 <small>/mês</small></span>
              </div>
              <span class="plan-badge-plat">VIP Máximo</span>
            </div>
            <ul class="plan-features">
              <li>🌍 Radar de alcance máximo até <strong>100 km</strong></li>
              <li>⚡ <strong>1 Flash Boost semanal grátis</strong> (topo da noite por 1h)</li>
              <li>⏳ <strong>Conversas Permanentes</strong> (Chat sem expiração)</li>
              <li>💎 Selo Platina Diamante & Verificação Prioritária</li>
              <li>↩️ Desfazer brindes enviados por engano</li>
            </ul>
            <button type="button" class="btn-upgrade-tier btn-tier-platina" onclick="event.stopPropagation(); window.azararApp.subscribeToPlan('platina', 'Plano Platina Black', 69.90)">
              Assinar Platina (R$ 69,90)
            </button>
          </div>

        </div>

        <div class="vip-guarantee-note">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="#22c55e"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
          <span>Cancele a qualquer momento. Pagamento seguro via Pix ou Cartão.</span>
        </div>
      </div>
    </div>

    <!-- ============================================ -->
    <!-- MODAL: FLASH BOOST (DESTAQUE NA NOITE)      -->
    <!-- ============================================ -->
    <div class="app-modal" id="modalFlashBoost" role="dialog" aria-modal="true">
      <div class="modal-backdrop" onclick="window.azararApp.closeFlashBoostModal()"></div>
      <div class="modal-card-sheet flash-boost-sheet">
        <div class="modal-header">
          <h3 class="modal-title">⚡ Flash Boost Camarote</h3>
          <button class="modal-close-btn" onclick="window.azararApp.closeFlashBoostModal()">✕</button>
        </div>

        <div class="boost-hero-graphic">
          <div class="boost-icon-pulse">⚡</div>
          <h4 class="boost-callout-title">Seja o Perfil nº 1 da Balada por 1 Hora!</h4>
          <p class="boost-callout-desc">Seu perfil e momentos serão exibidos no topo do Radar e do Lounge VIP para todos os usuários em um raio de até 10 km.</p>
        </div>

        <div class="boost-pricing-box">
          <div class="boost-price-tag">
            <span class="boost-val">R$ 9,90</span>
            <span class="boost-period">/ 1 hora de destaque</span>
          </div>
          <button type="button" class="btn-primary btn-activate-boost" onclick="window.azararApp.activateFlashBoost()">
            🚀 Ativar Flash Boost Agora
          </button>
        </div>
      </div>
    </div>

    <!-- Toast Notification -->
    <div class="toast-notification" id="toastNotification" aria-live="polite"></div>

  </main>

  <!-- JavaScript -->
  <script src="/js/app.js?v=<%= Time.current.to_i %>"></script>
</body>
</html>