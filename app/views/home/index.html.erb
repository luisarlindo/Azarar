<script>
  window.INITIAL_CURRENT_USER = <%= raw((@user_json || (current_user ? {
    id: current_user.id,
    name: current_user.name,
    username: current_user.username,
    avatar: current_user.display_avatar,
    isVerified: current_user.verified?,
    verified: current_user.verified?,
    is_verified: current_user.verified?,
    faceSimilarityScore: current_user.face_similarity_score || 98.8,
    bio: current_user.bio,
    intent: current_user.intentions || "Relacionamento Sério",
    vibe: current_user.vibe || "🍹 No balcão do bar",
    isOnline: current_user.online_now,
    plan: current_user.current_plan,
    planName: current_user.plan_name,
    planBadge: current_user.plan_badge,
    maxRadius: current_user.max_radar_distance,
    planExpiresAt: current_user.plan_expires_at&.iso8601
  } : nil)).to_json) %>;
</script>

<!-- Main Application Screen -->
  <main class="app-screen">
    
    <!-- Screen Container (Isolated In-App Views Container) -->
    <div class="screen-container <%= (@user_json || current_user) ? 'view-mode-app-shell' : 'view-mode-home' %>" id="screenContainer">
      
      <!-- ============================================ -->
      <!-- VIEW 1: HOME / LANDING SCREEN (Logged Out)  -->
      <!-- ============================================ -->
      <section class="app-view view-home <%= (@user_json || current_user) ? '' : 'active' %>" id="viewHome">

        <!-- Cinematic Ambient Crossfade Background Slideshow -->
        <div class="az-hero-slideshow" id="heroBgSlideshow" aria-hidden="true">
          <div class="az-hero-slide active" style="background-image: url('/assets/images/bg.png');" data-index="0"></div>
          <div class="az-hero-slide" style="background-image: url('/assets/images/bg-cheers.jpg');" data-index="1"></div>
          <div class="az-hero-slide" style="background-image: url('/assets/images/bg-rooftop.jpg');" data-index="2"></div>
          <div class="az-hero-slide" style="background-image: url('/assets/images/bg-nightlife.jpg');" data-index="3"></div>
          <div class="az-hero-overlay"></div>
        </div>

        <!-- Ambient Particles Canvas (Floating in front of the atmospheric scenes) -->
        <canvas id="particlesCanvas" class="particles-canvas"></canvas>

        <!-- Top Branding Section -->
        <header class="app-header">
          <div class="logo-wrapper">
            <div class="logo-glow-aura"></div>
            <img src="/assets/images/logo.png" alt="AZARAR Logo" class="brand-logo" id="homeBrandLogo" />
            <div class="logo-sparkles-orbit">
              <span class="logo-sparkle sp-1"></span>
              <span class="logo-sparkle sp-2"></span>
              <span class="logo-sparkle sp-3"></span>
              <span class="logo-sparkle sp-4"></span>
            </div>
          </div>

          <div class="heart-divider">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="#ff2a7a">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
          </div>

          <p class="brand-tagline">
            Conecte-se com quem<br />
            desperta seu <span class="tagline-highlight">interesse</span>
          </p>
        </header>

        <!-- Bottom Actions -->
        <footer class="app-actions">
          <button class="btn-primary" id="btnCreateAccount" type="button" onclick="window.azararApp.showView('register')">
            <span class="btn-text">Criar conta</span>
            <span class="btn-arrow">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </span>
          </button>

          <button class="btn-secondary" id="btnLogin" type="button" onclick="window.azararApp.showView('login')">
            <span class="btn-text">Entrar</span>
          </button>

          <div class="security-badge">
            <svg class="shield-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#ff2a7a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <polyline points="9 12 11 14 15 10"></polyline>
            </svg>
            <span class="security-text">Seguro, discreto e feito para conexões reais</span>
          </div>
        </footer>

      </section>

      <!-- ============================================ -->
      <!-- VIEW 2: CRIAR CONTA (Logged Out)             -->
      <!-- ============================================ -->
      <section class="app-view view-register" id="viewRegister" aria-labelledby="regScreenTitle">
        <nav class="view-navbar">
          <button class="nav-back-btn" type="button" onclick="window.azararApp.showView('home')" aria-label="Voltar">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <div class="nav-brand-wrap">
            <img src="/assets/images/logo.png" alt="AZARAR" class="nav-mini-logo" />
          </div>
          <div class="nav-placeholder"></div>
        </nav>

        <div class="view-scroll-content">
          <div class="form-intro">
            <h1 class="view-title" id="regScreenTitle">Criar nova conta</h1>
            <p class="view-subtitle">Junte-se à maior comunidade de conexões e encontros.</p>
          </div>

          <form class="app-form" id="registerForm" onsubmit="event.preventDefault(); window.azararApp.handleRegisterSubmit();">
            
            <div class="form-group">
              <label for="regFullName">Nome completo</label>
              <div class="input-wrap">
                <span class="input-icon">
                  <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                </span>
                <input type="text" id="regFullName" placeholder="Seu nome e sobrenome" required autocomplete="name" />
              </div>
            </div>

            <div class="form-group">
              <label for="regBirthDate">Data de nascimento</label>
              <div class="input-wrap">
                <span class="input-icon">
                  <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                </span>
                <input type="date" id="regBirthDate" required />
              </div>
            </div>

            <div class="form-group">
              <label for="regUsername">Nome de perfil (@usuario)</label>
              <div class="input-wrap input-username-wrap">
                <span class="input-prefix">@</span>
                <input type="text" id="regUsername" placeholder="seuusuario" required pattern="[a-zA-Z0-9._]+" autocomplete="username" />
              </div>
            </div>

            <div class="form-group">
              <label for="regEmailPhone">E-mail ou Telefone</label>
              <div class="input-wrap">
                <span class="input-icon">
                  <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                </span>
                <input type="text" id="regEmailPhone" placeholder="seuemail@exemplo.com ou (11) 99999-9999" required />
              </div>
            </div>

            <!-- Relationship Goal Selection -->
            <div class="form-group">
              <label>O que você busca no Azarar?</label>
              <div class="intent-chips-grid" id="regIntentChips">
                <button type="button" class="intent-chip active" data-intent="Relacionamento Sério">💍 Relacionamento Sério</button>
                <button type="button" class="intent-chip" data-intent="Casual">🍹 Encontros Casuais</button>
                <button type="button" class="intent-chip" data-intent="Sexo">💋 Sexo sem tabus</button>
                <button type="button" class="intent-chip" data-intent="Companhia">✨ Companhia & Amizade</button>
              </div>
            </div>

            <div class="form-group">
              <label for="regPassword">Senha</label>
              <div class="input-wrap">
                <span class="input-icon">
                  <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                </span>
                <input type="password" id="regPassword" placeholder="Mínimo 6 caracteres" required minlength="6" autocomplete="new-password" />
                <button type="button" class="btn-toggle-pwd" onclick="window.azararApp.togglePasswordVisibility('regPassword', this)" aria-label="Mostrar/ocultar senha">
                  <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                </button>
              </div>
            </div>

            <div class="form-group">
              <label for="regPasswordConfirm">Confirmação de senha</label>
              <div class="input-wrap">
                <span class="input-icon">
                  <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11 14 15 10"></polyline>
                </span>
                <input type="password" id="regPasswordConfirm" placeholder="Repita sua senha" required minlength="6" autocomplete="new-password" />
                <button type="button" class="btn-toggle-pwd" onclick="window.azararApp.togglePasswordVisibility('regPasswordConfirm', this)" aria-label="Mostrar/ocultar senha">
                  <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                </button>
              </div>
            </div>

            <button type="submit" class="btn-primary form-submit-btn">
              <span class="btn-text">Criar conta e Começar</span>
              <span class="btn-arrow">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </span>
            </button>

          </form>

          <p class="form-switch-prompt">
            Já tem uma conta? <button type="button" class="link-switch" onclick="window.azararApp.showView('login')">Entrar</button>
          </p>
        </div>
      </section>

      <!-- ============================================ -->
      <!-- VIEW 3: LOGIN (Logged Out)                   -->
      <!-- ============================================ -->
      <section class="app-view view-login" id="viewLogin" aria-labelledby="loginScreenTitle">
        <nav class="view-navbar">
          <button class="nav-back-btn" type="button" onclick="window.azararApp.showView('home')" aria-label="Voltar">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <div class="nav-brand-wrap">
            <img src="/assets/images/logo.png" alt="AZARAR" class="nav-mini-logo" />
          </div>
          <div class="nav-placeholder"></div>
        </nav>

        <div class="view-scroll-content">
          <div class="form-intro">
            <h1 class="view-title" id="loginScreenTitle">Bem-vindo de volta</h1>
            <p class="view-subtitle">Acesse sua conta para ver suas conexões e mensagens.</p>
          </div>

          <form class="app-form" id="loginForm" onsubmit="event.preventDefault(); window.azararApp.handleLoginSubmit();">
            
            <div class="form-group">
              <label for="loginUser">E-mail, Telefone ou @usuario</label>
              <div class="input-wrap">
                <span class="input-icon">
                  <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                </span>
                <input type="text" id="loginUser" placeholder="seuemail@exemplo.com ou @usuario" required autocomplete="username" />
              </div>
            </div>

            <div class="form-group">
              <div class="label-row">
                <label for="loginPass">Sua Senha</label>
                <a href="#" class="forgot-link" onclick="window.azararApp.toast('Link de recuperação enviado!')">Esqueci a senha</a>
              </div>
              <div class="input-wrap">
                <span class="input-icon">
                  <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                </span>
                <input type="password" id="loginPass" placeholder="Digite sua senha" required autocomplete="current-password" />
                <button type="button" class="btn-toggle-pwd" onclick="window.azararApp.togglePasswordVisibility('loginPass', this)" aria-label="Mostrar/ocultar senha">
                  <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                </button>
              </div>
            </div>

            <button type="submit" class="btn-primary form-submit-btn">
              <span class="btn-text">Entrar no Azarar</span>
              <span class="btn-arrow">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </span>
            </button>

            <!-- Biometric Login (Face ID) -->
            <div class="auth-divider">
              <span class="divider-line"></span>
              <span class="divider-text">OU ACESSE COM BIOMETRIA</span>
              <span class="divider-line"></span>
            </div>

            <button type="button" class="btn-face-login" onclick="window.azararApp.openFaceLoginModal()">
              <div class="face-id-icon-box">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2">
                  <path d="M7 3H5a2 2 0 0 0-2 2v2m18 0V5a2 2 0 0 0-2-2h-2m4 14v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2"></path>
                  <circle cx="9" cy="9" r="1.5" fill="currentColor"></circle>
                  <circle cx="15" cy="9" r="1.5" fill="currentColor"></circle>
                  <path d="M10 13c.5.5 1.5.5 2 0"></path>
                  <path d="M8 17c1.8 1.5 6.2 1.5 8 0"></path>
                </svg>
              </div>
              <span class="btn-face-title">Entrar com Reconhecimento Facial</span>
              <span class="badge-face-id">Face ID</span>
            </button>

            <div style="margin-top: 14px; text-align: center;">
              <button type="button" class="az-btn-demo-fill" onclick="document.getElementById('loginUser').value='luis'; document.getElementById('loginPass').value='123456'; window.azararApp.handleLoginSubmit();" style="background: rgba(255, 255, 255, 0.05); border: 1px dashed rgba(255, 255, 255, 0.2); color: #94a3b8; font-size: 12px; padding: 8px 14px; border-radius: 10px; cursor: pointer; transition: all 0.2s;">
                ⚡ Entrar rápido como Luis (Conta Demo)
              </button>
            </div>

          </form>

          <p class="form-switch-prompt">
            Não tem uma conta? <button type="button" class="link-switch" onclick="window.azararApp.showView('register')">Cadastre-se</button>
          </p>
        </div>
      </section>

      <!-- ============================================ -->
      <!-- VIEW 4: APP SHELL (Logged In Experience)     -->
      <!-- ============================================ -->
      <section class="app-view view-app-shell <%= (@user_json || current_user) ? 'active' : '' %>" id="viewAppShell">
        
        <!-- App Top Header (Brand on Left, Unified Menu Button on Top Right) -->
        <header class="az-topbar">
          <div class="az-topbar-brand">
            <span class="az-logo-text">AZARAR</span>
          </div>
          
          <div class="az-topbar-right">
            <button type="button" class="az-topbar-btn-menu" id="btnTopbarMenu" onclick="window.azararApp.toggleSideMenu()" aria-label="Menu Principal" title="Abrir Menu">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"></line><line x1="4" y1="12" x2="20" y2="12"></line><line x1="4" y1="17" x2="20" y2="17"></line></svg>
            </button>
          </div>
        </header>

        <!-- SIDE MENU DRAWER (SLIDES IN FROM THE RIGHT) -->
        <div class="az-side-drawer-overlay" id="azSideMenuOverlay" onclick="window.azararApp.toggleSideMenu(false)"></div>
        <aside class="az-side-drawer az-side-drawer-right" id="azSideMenuDrawer" aria-label="Menu Principal">
          <div class="az-drawer-header">
            <div class="az-drawer-user-info">
              <img src="/images/avatars/luisarlindo.jpg" id="azDrawerAvatar" alt="Perfil" class="az-drawer-avatar" />
              <div>
                <h4 class="az-drawer-name" id="azDrawerName">Luis Arlindo</h4>
                <span class="az-drawer-handle" id="azDrawerHandle">@luisarlindo</span>
              </div>
            </div>
            <button type="button" class="az-drawer-close-btn" onclick="window.azararApp.toggleSideMenu(false)" aria-label="Fechar Menu">✕</button>
          </div>

          <nav class="az-drawer-nav">
            <div class="az-drawer-section-label">NAVEGAÇÃO</div>
            <button type="button" class="az-drawer-item active" id="drawerNavRadar" onclick="window.azararApp.switchTab('radar'); window.azararApp.toggleSideMenu(false);">
              <span class="az-drawer-icon">🔮</span>
              <span>Radar de Conexões</span>
            </button>
            <button type="button" class="az-drawer-item" id="drawerNavVenues" onclick="window.azararApp.switchTab('venues'); window.azararApp.toggleSideMenu(false);">
              <span class="az-drawer-icon">📍</span>
              <span>Locais & Bares</span>
            </button>
            <button type="button" class="az-drawer-item" id="drawerNavLikes" onclick="window.azararApp.switchTab('likes'); window.azararApp.toggleSideMenu(false);">
              <span class="az-drawer-icon">💖</span>
              <span>Curtidas & Brindes</span>
            </button>
            <button type="button" class="az-drawer-item" id="drawerNavMessages" onclick="window.azararApp.switchTab('messages'); window.azararApp.toggleSideMenu(false);">
              <span class="az-drawer-icon">💬</span>
              <span>Mensagens & Notificações</span>
            </button>
            <button type="button" class="az-drawer-item" id="drawerNavProfile" onclick="window.azararApp.switchTab('profile'); window.azararApp.toggleSideMenu(false);">
              <span class="az-drawer-icon">👤</span>
              <span>Meu Perfil</span>
            </button>

            <div class="az-drawer-divider"></div>
            <div class="az-drawer-section-label">ESTABELECIMENTOS & PARCEIROS</div>
            <button type="button" class="az-drawer-item b2b-gold" onclick="window.azararApp.openRegisterVenueModal(); window.azararApp.toggleSideMenu(false);">
              <span class="az-drawer-icon">🏢</span>
              <span>Cadastrar Locais</span>
              <span class="az-drawer-tag-b2b">1 a 5 ⭐</span>
            </button>
            <button type="button" class="az-drawer-item" onclick="window.azararApp.openRegisteredVenuesSearchModal(); window.azararApp.toggleSideMenu(false);">
              <span class="az-drawer-icon">📍</span>
              <span>Locais Cadastrados</span>
            </button>

            <div class="az-drawer-divider"></div>
            <div class="az-drawer-section-label">RECURSOS & VIP</div>
            <button type="button" class="az-drawer-item" onclick="window.azararApp.openEditProfileModal(); window.azararApp.toggleSideMenu(false);">
              <span class="az-drawer-icon">✏️</span>
              <span>Editar Perfil</span>
            </button>
            <button type="button" class="az-drawer-item" onclick="window.azararApp.openVipPlansModal(); window.azararApp.toggleSideMenu(false);">
              <span class="az-drawer-icon">💎</span>
              <span>Planos VIP & Raio</span>
            </button>
            <button type="button" class="az-drawer-item" onclick="window.azararApp.openFlashBoostModal(); window.azararApp.toggleSideMenu(false);">
              <span class="az-drawer-icon">⚡</span>
              <span>Turbinar Perfil (Boost)</span>
            </button>
            <button type="button" class="az-drawer-item" onclick="window.azararApp.openFaceVerificationModal(); window.azararApp.toggleSideMenu(false);">
              <span class="az-drawer-icon">🛡️</span>
              <span>Verificação Facial</span>
            </button>

            <div class="az-drawer-divider"></div>
            <!-- OPÇÃO SAIR / DESLOGAR -->
            <button type="button" class="az-drawer-item az-drawer-item-logout" onclick="window.azararApp.handleLogout();" aria-label="Sair da Conta">
              <span class="az-drawer-icon">🚪</span>
              <span class="az-logout-text">Sair da Conta (Deslogar)</span>
            </button>
          </nav>

          <div class="az-drawer-footer">
            AZARAR Social Network © 2026<br>
            Versão 2.4.0 • Conexões Reais
          </div>
        </aside>

        <!-- Dynamic Tab Pages Container -->
        <div class="tab-content-container" id="tabContentContainer">
          
          <!-- TAB 1: RADAR / INÍCIO (EXACT FIDELITY TO REFERENCE DESIGN) -->
          <div class="tab-page tab-radar active" id="tabRadar">
            <div class="az-dashboard-grid">
              
              <!-- ================= LEFT COLUMN ================= -->
              <div class="az-col-left">
                
                <!-- 1. USER PROFILE CARD -->
                <div class="az-card az-profile-card" id="heroProfileCard">
                  <div class="az-profile-photo-wrap">
                    <img src="/images/avatars/luisarlindo.jpg" id="heroProfileAvatar" alt="Lucas" class="az-profile-photo" />
                    
                    <!-- Edit Photo Button Top Right -->
                    <button type="button" class="az-btn-photo-edit" onclick="window.azararApp.openEditProfileModal()" title="Editar Foto">
                      <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                    </button>
                    
                    <!-- Verified Pill Bottom Left -->
                    <div class="az-verified-pill">
                      <svg viewBox="0 0 24 24" width="9" height="9" fill="none" stroke="#22c55e" stroke-width="3.2" stroke-linecap="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                      <span>VERIFICADO</span>
                      <svg viewBox="0 0 24 24" width="8" height="8" fill="currentColor"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/></svg>
