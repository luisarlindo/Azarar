<div class="tab-page tab-profile active" style="display: flex;">
  <div class="profile-hero">
    <div class="profile-avatar-container">
      <img src="<%= @user.display_avatar %>" alt="Foto de perfil" class="profile-hero-avatar" />
      <% if @user == current_user %>
        <a href="<%= edit_profile_path %>" class="btn-change-avatar" title="Editar perfil">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg>
        </a>
      <% end %>
    </div>

    <div class="profile-hero-info">
      <div class="name-row">
        <h2 class="profile-fullname"><%= @user.name %><% if @user.age %>, <%= @user.age %><% end %></h2>
        <span class="verified-check" title="Perfil Verificado">âœ“</span>
      </div>
      <span class="profile-handle"><%= @user.formatted_username %></span>
      
      <div class="profile-intent-pill">
        <span><%= @user.intentions.presence || 'âœ¨ ConexÃµes & Encontros' %></span>
      </div>
    </div>
  </div>

  <div class="profile-stats-bar">
    <div class="stat-column">
      <strong class="stat-val"><%= @posts.count %></strong>
      <span class="stat-txt">Posts</span>
    </div>
    <div class="stat-column">
      <strong class="stat-val">148</strong>
      <span class="stat-txt">Seguidores</span>
    </div>
    <div class="stat-column">
      <strong class="stat-val">92</strong>
      <span class="stat-txt">Seguindo</span>
    </div>
  </div>

  <div class="profile-bio-card">
    <p class="profile-bio-text"><%= @user.bio.presence || "Sem biografia cadastrada ainda." %></p>
    <div class="profile-location-row">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
      <span>No seu raio agora â€¢ <%= @user.radius_meters %>m</span>
    </div>
  </div>

  <div class="profile-actions-row">
    <% if @user == current_user %>
      <a href="<%= edit_profile_path %>" class="btn-profile-action btn-edit-prof">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
        Editar Perfil
      </a>
      <%= button_to session_path, method: :delete, class: "btn-profile-action btn-logout-prof", form_class: "inline-block flex-1" do %>
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
        Sair
      <% end %>
    <% else %>
      <a href="<%= direct_message_path(@user) %>" class="btn-primary" style="height: 44px; text-decoration: none;">
        <span>Enviar Mensagem Privada</span>
      </a>
    <% end %>
  </div>

  <div class="instagram-photo-grid" style="margin-top: 14px;">
    <% @posts.each do |p| %>
      <% if p.image_url.present? %>
        <div class="grid-photo-item">
          <img src="<%= p.image_url %>" alt="Post" />
        </div>
      <% end %>
    <% end %>
  </div>
</div>