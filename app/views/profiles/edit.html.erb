<div class="tab-page active" style="display: flex; padding-top: 8px;">
  <div class="form-intro" style="display: flex; align-items: center; justify-content: space-between;">
    <h1 class="view-title">Editar Perfil</h1>
    <a href="<%= profile_path %>" class="link-switch" style="font-size: 14px;">Cancelar</a>
  </div>

  <%= form_with model: @user, url: profile_path, method: :patch, class: "app-form", data: { turbo: false } do |f| %>
    <div class="form-group">
      <%= f.label :name, "Nome completo" %>
      <div class="input-wrap">
        <%= f.text_field :name, required: true %>
      </div>
    </div>

    <div class="form-group">
      <%= f.label :bio, "Biografia" %>
      <div class="input-wrap">
        <%= f.text_area :bio, rows: 3, placeholder: "Conte um pouco sobre vocÃª..." %>
      </div>
    </div>

    <div class="form-group">
      <%= f.label :intentions, "O que vocÃª busca?" %>
      <div class="input-wrap">
        <%= f.text_field :intentions, placeholder: "Ex: Relacionamento SÃ©rio, Casual, Companhia..." %>
      </div>
    </div>

    <div class="form-group">
      <%= f.label :avatar_url, "URL da Foto de Perfil" %>
      <div class="input-wrap">
        <%= f.url_field :avatar_url, placeholder: "https://..." %>
      </div>
    </div>

    <button type="submit" class="btn-primary" style="margin-top: 10px; height: 50px;">
      <span>Salvar AlteraÃ§Ãµes</span>
    </button>
  <% end %>
</div>