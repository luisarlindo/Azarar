<div class="tab-page tab-messages active" style="display: flex;">
  <div class="messages-header">
    <h2 class="messages-title">Conversas</h2>
  </div>

  <a href="<%= mural_index_path %>" class="pinned-mural-card" style="text-decoration: none; color: inherit;">
    <div class="pinned-icon-wrap">ðŸ”¥</div>
    <div class="pinned-info">
      <div class="pinned-top-row">
        <strong class="pinned-name">Mural do Raio Local</strong>
        <span class="pinned-badge">Ao Vivo</span>
      </div>
      <p class="pinned-last-msg">Toque para ver o chat aberto da regiÃ£o</p>
    </div>
  </a>

  <div class="direct-chats-section">
    <h3 class="section-subheading">Mensagens Diretas</h3>
    <div class="conversations-list">
      <% @contacts.each do |contact| %>
        <a href="<%= direct_message_path(contact) %>" class="conversation-item" style="text-decoration: none; color: inherit; display: flex; align-items: center; gap: 12px; padding: 12px; background: rgba(22, 9, 32, 0.6); border-radius: 16px; margin-bottom: 8px; border: 1px solid rgba(255,255,255,0.06);">
          <img src="<%= contact.display_avatar %>" alt="<%= contact.name %>" style="width: 48px; height: 48px; border-radius: 50%; object-fit: cover;" />
          <div style="flex: 1;">
            <div style="display: flex; justify-content: space-between;">
              <strong style="font-size: 14px;"><%= contact.name %></strong>
              <span style="font-size: 11px; color: #ff2a7a;">ðŸ“ <%= contact.radius_meters %>m</span>
            </div>
            <p style="font-size: 12px; color: rgba(255,255,255,0.6); margin-top: 2px;"><%= contact.formatted_username %></p>
          </div>
        </a>
      <% end %>

      <% if @contacts.empty? %>
        <p style="font-size: 13px; color: rgba(255,255,255,0.5); text-align: center; padding: 20px 0;">VocÃª ainda nÃ£o tem conversas ativas. ConheÃ§a pessoas no Radar!</p>
      <% end %>
    </div>

    <% if @suggested.any? %>
      <h3 class="section-subheading" style="margin-top: 18px;">Pessoas Sugeridas</h3>
      <div class="conversations-list">
        <% @suggested.each do |user| %>
          <a href="<%= direct_message_path(user) %>" class="conversation-item" style="text-decoration: none; color: inherit; display: flex; align-items: center; gap: 12px; padding: 10px; background: rgba(22, 9, 32, 0.4); border-radius: 14px; margin-bottom: 8px; border: 1px solid rgba(255,255,255,0.04);">
            <img src="<%= user.display_avatar %>" alt="<%= user.name %>" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover;" />
            <div style="flex: 1;">
              <strong style="font-size: 13px;"><%= user.name %></strong>
              <span style="font-size: 11px; color: rgba(255,255,255,0.5); display: block;"><%= user.formatted_username %></span>
            </div>
            <span class="btn-card-chat" style="padding: 4px 10px; font-size: 11px;">Conversar</span>
          </a>
        <% end %>
      </div>
    <% end %>
  </div>
</div>