<header class="app-topbar">
  <div class="topbar-left">
    <a href="<%= mural_index_path %>">
      <%= image_tag "logo.png", alt: "AZARAR", class: "topbar-logo" %>
    </a>
  </div>
  
  <div class="topbar-right">
    <div class="online-status-badge <%= current_user.online_now? ? '' : 'offline' %>" id="topbarOnlineBadge" onclick="toggleOnlineBadge()">
      <span class="status-indicator-dot"></span>
      <span class="status-indicator-text" id="topbarOnlineText"><%= current_user.online_now? ? 'Online' : 'InvisÃ­vel' %></span>
    </div>
    
    <a href="<%= direct_messages_path %>" class="topbar-icon-btn" aria-label="Mensagens">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
      <span class="badge-unread-count">1</span>
    </a>
  </div>
</header>

<script>
  function toggleOnlineBadge() {
    const isCurrentlyOnline = !document.getElementById('topbarOnlineBadge').classList.contains('offline');
    const nextState = !isCurrentlyOnline;
    
    fetch('<%= profile_toggle_online_path %>', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').getAttribute('content')
      },
      body: JSON.stringify({ online_now: nextState })
    }).then(res => res.json()).then(data => {
      const badge = document.getElementById('topbarOnlineBadge');
      const text = document.getElementById('topbarOnlineText');
      if (data.online_now) {
        badge.classList.remove('offline');
        text.innerText = 'Online';
      } else {
        badge.classList.add('offline');
        text.innerText = 'InvisÃ­vel';
      }
      const chk = document.getElementById('chkOnlineNow');
      if (chk) chk.checked = data.online_now;
    });
  }
</script>